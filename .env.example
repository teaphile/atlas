# ATLAS research/demo configuration. Copy to .env; never commit real credentials.
# Free hosted Open-Meteo APIs are NON-COMMERCIAL. Review docs/API_GUIDE.md.
ATLAS_COLLECT=true
ATLAS_AUTH_REQUIRED=false
# For private deployment set auth_required=true and generate a random 32+ character secret.
ATLAS_API_KEY=
# Optional, free NASA FIRMS MAP_KEY. Keep server-side; never put it in frontend code.
ATLAS_FIRMS_MAP_KEY=
ATLAS_HTTP_TIMEOUT=12
ATLAS_MAX_RESPONSE_BYTES=4000000
ATLAS_MAX_CACHE_ENTRIES=384
# This is a process-local PEER limit. Behind a proxy, add a real ingress/user limiter.
ATLAS_RATE_LIMIT_PER_MINUTE=120
# Optional local path overrides:
# ATLAS_DATABASE_PATH=/data/atlas.sqlite3
# ATLAS_FRONTEND_PATH=/app/frontend/dist
# Set an honest operator contact in production if your provider asks for it:
# ATLAS_USER_AGENT=ATLAS/1.0 (operator contact: your actual address)
