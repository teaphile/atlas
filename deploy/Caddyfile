# Example for a real DNS name and HTTPS ingress, NOT the framed Arena preview.
# Run Caddy on the host, or adjust upstream routing for your container network.
{$ATLAS_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        +Content-Security-Policy "frame-ancestors 'none'"
        -Server
    }
    reverse_proxy 127.0.0.1:7860 {
        flush_interval -1
    }
}
