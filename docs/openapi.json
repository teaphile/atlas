  "components": {
    "schemas": {
      "AOIRequest": {
        "properties": {
          "geometry": {
            "additionalProperties": true,
            "type": "object",
            "title": "Geometry"
          },
          "kinds": {
            "items": {
              "$ref": "#/components/schemas/Kind"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Kinds"
          },
          "hours": {
            "type": "integer",
            "maximum": 720.0,
            "minimum": 1.0,
            "title": "Hours",
            "default": 168
          }
        },
        "type": "object",
        "required": [
          "geometry"
        ],
        "title": "AOIRequest"
      },
      "ErosionScenario": {
        "properties": {
          "rainfall_erosivity": {
            "type": "number",
            "maximum": 20000.0,
            "minimum": 0.0,
            "title": "Rainfall Erosivity",
            "description": "R: MJ\u00b7mm/(ha\u00b7h\u00b7year)"
          },
          "soil_erodibility": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Soil Erodibility",
            "description": "K: t\u00b7h/(MJ\u00b7mm)"
          },
          "slope_percent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Slope Percent"
          },
          "slope_length_m": {
            "type": "number",
            "maximum": 2000.0,
            "minimum": 1.0,
            "title": "Slope Length M"
          },
          "cover_factor": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Cover Factor"
          },
          "practice_factor": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Practice Factor"
          },
          "alternative_cover_factor": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Alternative Cover Factor"
          }
        },
        "type": "object",
        "required": [
          "rainfall_erosivity",
          "soil_erodibility",
          "slope_percent",
          "slope_length_m",
          "cover_factor",
          "practice_factor",
          "alternative_cover_factor"
        ],
        "title": "ErosionScenario"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Kind": {
        "type": "string",
        "enum": [
          "earthquake",
          "fire",
          "storm",
          "flood",
          "volcano",
          "drought",
          "weather",
          "aircraft",
          "camera",
          "satellite",
          "space",
          "news",
          "cyber",
          "other"
        ],
        "title": "Kind"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}